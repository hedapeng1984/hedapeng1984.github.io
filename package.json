{
  "name": "hedapeng-journal",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "prepare:diaries": "node scripts/content.mjs prepare",
    "review:status": "node scripts/content.mjs status",
    "check:content": "node scripts/content.mjs check",
    "build": "npm run check:content && node scripts/next.mjs build --webpack && node scripts/check-export.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "marked": "^16.4.1",
    "yaml": "^2.8.1"
  }
}
