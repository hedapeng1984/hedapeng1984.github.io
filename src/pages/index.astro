---
import Layout from '../layouts/Layout.astro';
import { getEntries, prettyDate } from '../lib/entries.mjs';
const entries = getEntries();
const filters = ['全部', ...new Set(entries.map(entry => entry.tags[0]))];
const demos = entries.filter(entry => entry.demo).length;
const notes = entries.length - demos;
---
<Layout active="home">
  <section class="hero">
    <div><p class="eyebrow">A PERSONAL JOURNAL <span>—</span> EST. 2026</p><h1>把日子，写成<br />慢慢展开的<span class="accent">书。</span></h1><p class="hero-description">关于生活、阅读，和一些不必急着回答的问题。<br />写下此刻，留给漫长的以后。</p></div>
    <aside class="hero-aside"><span class="vertical-note">在平常里，发现值得记住的事。</span><span class="issue-number">VOL. 01<span>初冬 · 试刊</span></span></aside>
  </section>
  <div class="section-heading"><div><span class="eyebrow">THE LATEST PAGES</span><h2>最近写下</h2></div><span class="trial-note">试刊 · {demos} 篇虚构日记 / {notes} 篇学习笔记</span></div>
  <div class="journal-tools"><div class="filter-tabs" role="group" aria-label="按主题筛选">{filters.map(tag => <button class:list={['filter', { active: tag === '全部' }]} data-tag={tag} aria-pressed={tag === '全部' ? 'true' : 'false'}>{tag}</button>)}</div><label class="search-label"><span>查找文字</span><input id="search" type="search" placeholder="搜索日记…" autocomplete="off" /></label></div>
  <section class="entry-list" aria-label="日记列表">
    {entries.map((entry, index) => <article class="entry-row" data-tags={entry.tags.join(' ')} data-search={`${entry.title} ${entry.summary} ${entry.body}`}><div class="entry-date"><span>{prettyDate(entry.date)}</span><small>{entry.date.slice(0, 4)}</small></div><div class="entry-content"><div class="entry-meta">{entry.tags.join(' / ')}{index === 0 && <span class="latest-label">新的一页</span>}</div><h3><a href={`/diary/${entry.id}/`}>{entry.title}</a></h3><p>{entry.summary}</p><a class="read-link" href={`/diary/${entry.id}/`}>继续阅读 <span aria-hidden="true">↗</span><span class="sr-only">：{entry.title}</span></a></div><span class="entry-index" aria-hidden="true">0{entries.length - index}</span></article>)}
  </section>
  <p id="search-status" class="search-status" aria-live="polite"></p>
  <div class="end-note"><span>·</span><p>有些日子很普通，<br />写下来，就有了自己的光。</p><a href="/archive/">翻看全部日记 <span aria-hidden="true">→</span></a></div>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#search');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  const rows = [...document.querySelectorAll<HTMLElement>('.entry-row')];
  const status = document.querySelector<HTMLElement>('#search-status');
  let tag = '全部';
  function filterEntries() {
    const query = (search?.value || '').trim().toLocaleLowerCase();
    let count = 0;
    for (const row of rows) { const show = (tag === '全部' || (row.dataset.tags || '').split(' ').includes(tag)) && (row.dataset.search || '').toLocaleLowerCase().includes(query); row.hidden = !show; if (show) count++; }
    if (status) status.textContent = count === 0 ? '还没有找到这段文字，换个关键词试试。' : (query || tag !== '全部' ? `找到 ${count} 篇日记` : '');
  }
  search?.addEventListener('input', filterEntries);
  filters.forEach(button => button.addEventListener('click', () => { tag = button.dataset.tag || '全部'; filters.forEach(item => { const selected = item === button; item.classList.toggle('active', selected); item.setAttribute('aria-pressed', String(selected)); }); filterEntries(); }));
</script>
